# Copy to `.env` next to this file to override the defaults the API starts with.
# Every value below is the default, so the app runs without any `.env` at all.
# `docker compose up` sets MONGO_HOST to the `mongo` service by itself.

# HTTP port of the API
PORT=3000

# MongoDB the API stores notes and users in
MONGO_HOST=localhost
MONGO_PORT=27017
MONGO_DATABASE=example-app

# JWT signing key and lifetime (seconds) for the tokens `POST /api/token` issues
JWT_SECRET=change-me
JWT_EXPIRES_IN=3600

# The client id the frontend sends in the password grant
AUTH_CLIENT_ID=example-app

# The one user the API seeds on its first start so that login works at once
ADMIN_USERNAME=admin@example.com
ADMIN_PASSWORD=change-me
