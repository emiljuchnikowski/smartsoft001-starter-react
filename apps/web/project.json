{
  "name": "web",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/web/src",
  "tags": [
    "scope:docs",
    "type:example-app"
  ],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "defaultConfiguration": "production",
      "cache": true,
      "outputs": [
        "{options.outputPath}"
      ],
      "options": {
        "outputPath": "dist/apps/web",
        "forwardAllArgs": false,
        "parallel": false,
        "commands": [
          "tsc -p apps/web/tsconfig.app.json --noEmit",
          "vite build --config apps/web/vite.config.ts"
        ]
      },
      "configurations": {
        "production": {},
        "demo": {
          "outputPath": "dist/apps/web-demo",
          "commands": [
            "tsc -p apps/web/tsconfig.app.json --noEmit",
            "vite build --config apps/web/vite.config.ts --mode demo"
          ]
        }
      }
    },
    "serve": {
      "continuous": true,
      "executor": "nx:run-commands",
      "options": {
        "command": "vite --config apps/web/vite.config.ts"
      }
    },
    "serve-static": {
      "continuous": true,
      "executor": "nx:run-commands",
      "dependsOn": [
        {
          "target": "build"
        }
      ],
      "options": {
        "command": "vite preview --config apps/web/vite.config.ts"
      },
      "configurations": {
        "demo": {
          "command": "vite preview --config apps/web/vite.config.ts --mode demo"
        }
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "options": {
        "lintFilePatterns": [
          "apps/web/**/*.{ts,tsx}"
        ]
      }
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": [
        "{workspaceRoot}/coverage/{projectRoot}"
      ],
      "options": {
        "jestConfig": "apps/web/jest.config.ts",
        "tsConfig": "apps/web/tsconfig.spec.json"
      }
    }
  }
}
