{
  "name": "web-e2e",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/web-e2e/src",
  "tags": [
    "scope:docs",
    "type:example-app"
  ],
  "implicitDependencies": [
    "web",
    "api"
  ],
  "targets": {
    "e2e": {
      "executor": "nx:run-commands",
      "cache": false,
      "parallelism": false,
      "options": {
        "command": "playwright test --config apps/web-e2e/playwright.config.ts"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "cache": false,
      "parallelism": false,
      "options": {
        "command": "node apps/web-e2e/run.mjs"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "options": {
        "lintFilePatterns": [
          "apps/web-e2e/**/*.{ts,mjs}"
        ]
      }
    }
  }
}
