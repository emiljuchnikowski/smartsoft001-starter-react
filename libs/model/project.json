{
  "name": "model",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/model/src",
  "projectType": "library",
  "tags": [
    "scope:docs",
    "type:example-app"
  ],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": [
        "default",
        "^default"
      ],
      "options": {
        "command": "tsc -p libs/model/tsconfig.lib.json --noEmit"
      }
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": [
        "{workspaceRoot}/coverage/{projectRoot}"
      ],
      "options": {
        "jestConfig": "libs/model/jest.config.ts",
        "tsConfig": "libs/model/tsconfig.spec.json"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "options": {
        "lintFilePatterns": [
          "libs/model/**/*.ts"
        ]
      }
    }
  }
}
